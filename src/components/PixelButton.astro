---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'ghost'; class?: string; }
const { href, variant = 'secondary', class: cls } = Astro.props;
const external = /^https?:/.test(href);
---
<a class:list={['jp-btn', `jp-btn--${variant}`, cls]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}><slot /></a>
