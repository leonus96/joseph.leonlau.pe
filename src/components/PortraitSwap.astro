---
/**
 * Pixel-art portrait (no frame, on the page background) that turns into the real photo.
 * On its own it swaps every few seconds; mouse hover, tap or Enter/Space take over.
 * Transition: the art's pixels turn into the photo's one by one, then the photo sharpens.
 * With prefers-reduced-motion there is no auto swap and a manual swap is instant.
 */
interface Props {
  art: string;        // pixel art, 1x, transparent background
  artDark?: string;   // same art with a lighter outline for dark pages
  photo: string;      // cut-out photo with the exact same framing and alpha
  label: string;      // accessible name of the toggle
  artWidth?: number;
  artHeight?: number;
}
const { art, artDark, photo, label, artWidth = 124, artHeight = 124 } = Astro.props;
---
<figure class="portrait m-0 shrink-0" data-portrait data-photo={photo} data-cols={artWidth}>
  <button type="button" class="portrait__btn" aria-pressed="false" aria-label={label} style={`aspect-ratio:${artWidth}/${artHeight}`}>
    <picture>
      {artDark && <source srcset={artDark} media="(prefers-color-scheme: dark)" />}
      <img class="portrait__art pixelated" src={art} alt="" width={artWidth} height={artHeight} fetchpriority="high" />
    </picture>
    <canvas class="portrait__photo" aria-hidden="true"></canvas>
  </button>
</figure>

<style>
  .portrait { display: flex; flex-direction: column; align-items: center; }
  .portrait__btn {
    position: relative; display: block; padding: 0; border: 0; background: transparent; cursor: pointer;
    width: 104px; line-height: 0;
  }
  @media (min-width: 360px) { .portrait__btn { width: 124px; } }
  @media (min-width: 768px) { .portrait__btn { width: 248px; } }
  @media (min-width: 1100px) { .portrait__btn { width: 372px; } }
  .portrait__art, .portrait__photo { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .portrait__photo { opacity: 0; pointer-events: none; }
  .portrait__photo.is-on { opacity: 1; }
  .portrait__art.is-hidden { opacity: 0; }
</style>

<script>
  // Transition = frames. 0 is the pixel art (the <img>); 1..DISSOLVE swap the art's pixels for the photo's,
  // one random pixel at a time; then the photo sharpens through SHARPEN resolutions to full detail.
  const DISSOLVE = 14, DISSOLVE_MS = 45;
  const SHARPEN = [2, 4, 0], SHARPEN_MS = 95;      // multiples of the art's columns; 0 = full resolution
  const LAST = DISSOLVE + SHARPEN.length;
  const ART_MS = 5000;         // auto cycle: time resting on the pixel art
  const PHOTO_MS = 3400;       // auto cycle: time on the photo (transition included)
  const FIRST_MS = 2500;       // first auto swap after load
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-portrait]')) {
    const btn = fig.querySelector<HTMLButtonElement>('.portrait__btn')!;
    const art = fig.querySelector<HTMLImageElement>('.portrait__art')!;
    const canvas = fig.querySelector<HTMLCanvasElement>('.portrait__photo')!;
    const ctx = canvas.getContext('2d')!;
    const cols = Number(fig.dataset.cols) || 124;
    const photo = new Image();
    photo.decoding = 'async';
    let ready = false;
    let frame = 0, target = 0, timer = 0;
    let lastPointer = 'mouse';
    let sized = false;
    let held = false;        // the visitor is controlling it (hover or a tap/keyboard toggle)
    let visible = true;
    let autoTimer = 0;

    // low-res buffers: the art and the photo at the art's resolution, and a random order for the pixels
    let rows = cols;
    const small = document.createElement('canvas');
    const sctx = small.getContext('2d', { willReadFrequently: true })!;
    let artPx: ImageData | null = null, photoPx: ImageData | null = null, mix: ImageData | null = null;
    let order: Float32Array | null = null;

    const load = () => {
      if (photo.src) return;
      photo.onload = () => { ready = true; if (target !== frame) tick(); };
      photo.src = fig.dataset.photo!;
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 2500 });
    else window.setTimeout(load, 1200);

    const size = () => {
      const r = btn.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(r.width * dpr));
      canvas.height = Math.max(1, Math.round(r.height * dpr));
      sized = true;
    };

    const prepare = () => {
      rows = Math.round(cols * (art.naturalHeight || cols) / (art.naturalWidth || cols));
      small.width = cols; small.height = rows;
      sctx.imageSmoothingEnabled = false;
      sctx.clearRect(0, 0, cols, rows); sctx.drawImage(art, 0, 0, cols, rows);   // currentSrc: light or dark art
      artPx = sctx.getImageData(0, 0, cols, rows);
      sctx.imageSmoothingEnabled = true; sctx.imageSmoothingQuality = 'high';
      sctx.clearRect(0, 0, cols, rows); sctx.drawImage(photo, 0, 0, cols, rows);
      photoPx = sctx.getImageData(0, 0, cols, rows);
      mix = sctx.createImageData(cols, rows);
      if (!order) { order = new Float32Array(cols * rows); for (let i = 0; i < order.length; i++) order[i] = Math.random(); }
    };

    const blit = (src: CanvasImageSource) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(src, 0, 0, canvas.width, canvas.height);
    };

    const draw = () => {
      if (!sized) size();
      if (frame <= DISSOLVE) {
        const t = frame / DISSOLVE, a = artPx!.data, p = photoPx!.data, m = mix!.data;
        for (let i = 0, n = order!.length; i < n; i++) {
          const s = order![i] < t ? p : a, k = i * 4;
          m[k] = s[k]; m[k + 1] = s[k + 1]; m[k + 2] = s[k + 2]; m[k + 3] = s[k + 3];
        }
        sctx.putImageData(mix!, 0, 0);
        blit(small);
        return;
      }
      const mult = SHARPEN[frame - DISSOLVE - 1];
      if (mult === 0) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.imageSmoothingEnabled = true;
        ctx.drawImage(photo, 0, 0, canvas.width, canvas.height);
        return;
      }
      const off = document.createElement('canvas');
      off.width = cols * mult; off.height = rows * mult;
      const o = off.getContext('2d')!;
      o.imageSmoothingEnabled = true; o.imageSmoothingQuality = 'high';
      o.drawImage(photo, 0, 0, off.width, off.height);
      blit(off);
    };

    const render = () => {
      if (frame === 0) { canvas.classList.remove('is-on'); art.classList.remove('is-hidden'); return; }
      draw();
      canvas.classList.add('is-on');
      art.classList.add('is-hidden');   // the canvas carries both images during the transition
    };

    function tick() {
      window.clearTimeout(timer);
      if (!ready) { load(); return; }
      if (frame === 0 && target > 0) prepare();
      if (reduce()) { frame = target; render(); return; }
      if (frame === target) return;
      frame += target > frame ? 1 : -1;
      render();
      if (frame !== target) timer = window.setTimeout(tick, frame < DISSOLVE || (frame === DISSOLVE && target < frame) ? DISSOLVE_MS : SHARPEN_MS);
    }

    const show = (on: boolean) => {
      target = on ? LAST : 0;
      load();
      tick();
    };

    // ---- auto cycle: art for a while, photo for a moment, repeat ----
    const schedule = (ms: number) => {
      window.clearTimeout(autoTimer);
      if (reduce()) return;
      autoTimer = window.setTimeout(autoStep, ms);
    };
    function autoStep() {
      if (held || !visible || document.hidden || !ready) { load(); schedule(1000); return; }
      const on = target === 0;
      show(on);
      schedule(on ? PHOTO_MS : ART_MS);
    }
    schedule(FIRST_MS);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(btn);

    // ---- the visitor takes over ----
    const takeOver = (on: boolean) => {
      held = on;
      btn.setAttribute('aria-pressed', String(on));
      show(on);
      if (!on) schedule(ART_MS);
    };
    btn.addEventListener('pointerdown', (e) => { lastPointer = e.pointerType || 'mouse'; });
    btn.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') takeOver(true); });
    btn.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') takeOver(false); });
    btn.addEventListener('click', (e) => {
      // mouse users already toggle on hover; taps and keyboard toggle here
      const viaMouse = lastPointer === 'mouse' && (e as MouseEvent).detail > 0;
      if (!viaMouse) takeOver(btn.getAttribute('aria-pressed') !== 'true');
      lastPointer = 'mouse';
    });
    window.addEventListener('resize', () => { size(); if (frame > 0) draw(); });
  }
</script>
