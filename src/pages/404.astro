---
import Base from '../layouts/Base.astro';
import PixelButton from '../components/PixelButton.astro';
---
<Base lang="es" title="404 — Joseph León" description="Página no encontrada." noindex>
  <main class="wrap flex min-h-[80dvh] flex-col items-start justify-center gap-6">
    <p class="m-0 font-display text-[96px] leading-none font-bold md:text-[160px]">404</p>
    <p class="m-0 text-xl">Esta página no existe. <span lang="en" class="text-muted">This page doesn’t exist.</span></p>
    <PixelButton variant="primary" href="/">Joseph León</PixelButton>
  </main>
</Base>
