---
/** Project page: what it is in a few lines, and a primary button to the product itself. */
import Base from '../layouts/Base.astro';
import BackStrip from '../components/BackStrip.astro';
import PixelButton from '../components/PixelButton.astro';
import Badge from '../components/Badge.astro';
import { projects } from '../data/projects';
import { type Lang, path } from '../i18n';

interface Props { lang: Lang; id: 'obsiva' | 'ginesis'; }
const { lang, id } = Astro.props;
const p = projects.find((x) => x.id === id)!;
const page = p.page!;

const t = {
  es: { features: 'Qué hace', footer: 'Un proyecto de Joseph León', more: 'Más proyectos' },
  en: { features: 'What it does', footer: 'A project by Joseph León', more: 'More projects' },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  url: page.url,
  description: page.lead[lang],
  applicationCategory: 'BusinessApplication',
  operatingSystem: p.meta.en.replace(/ · /g, ', '),
  author: { '@type': 'Person', name: 'Joseph León' },
};
---
<Base lang={lang} title={`${p.name} — ${page.tagline[lang]}`} description={page.lead[lang]} route={p.route}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <BackStrip lang={lang} route={p.route} tone="auto" />

  <main>
    <section class="wrap project pt-8 pb-10 md:pt-14 md:pb-16" aria-labelledby="project-h">
      <div class="project__text flex flex-col gap-5 md:gap-6">
        <div class="flex flex-wrap items-center gap-3">
          <Badge tone={p.status}>{p.statusLabel[lang]}</Badge>
          <span class="text-sm font-medium text-muted">{p.meta[lang]}</span>
        </div>
        <h1 id="project-h" class="h-name">{p.name}</h1>
        <p class="m-0 font-display text-[24px] leading-[30px] font-semibold md:text-[32px] md:leading-[38px]">{page.tagline[lang]}</p>
        <p class="m-0 max-w-[520px] text-[18px] leading-7 text-muted md:text-xl md:leading-8">{page.lead[lang]}</p>
        <div class="pt-1">
          <PixelButton variant="primary" href={page.url}>{page.cta[lang]} ↗</PixelButton>
        </div>
      </div>

      <div class="project__tape jp-frame jp-frame--shadow" aria-hidden="true">
        <div class="jp-card__grip"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="jp-card__tile project__tile" style={`background:${p.tile}`}>
          {p.logo && <img src={p.logo.src} alt="" width={p.logo.width} height={p.logo.height} class="h-11 w-auto md:h-14" />}
        </div>
        <div class="h-5 md:h-6"></div>
      </div>
    </section>

    <div class="dither" aria-hidden="true"></div>

    <section class="wrap flex flex-col gap-6 pt-10 pb-14 md:gap-8 md:pt-14 md:pb-20" aria-labelledby="features-h">
      <h2 id="features-h" class="h-section">{t.features}</h2>
      <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3 md:gap-8">
        {page.features.map((f) => (
          <li class="jp-frame flex flex-col gap-2 p-5 md:p-6">
            <h3 class="m-0 font-display text-[22px] leading-7 font-semibold">{f.h[lang]}</h3>
            <p class="m-0 text-[17px] leading-[26px]">{f.p[lang]}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="border-t-4 border-ink">
    <div class="wrap flex flex-wrap justify-between gap-4 py-5 text-sm text-muted">
      <span>© {new Date().getFullYear()} {p.name} · {t.footer}</span>
      <a href={`${path('home', lang)}#proyectos`} class="text-ink">{t.more}</a>
    </div>
  </footer>
</Base>

<style>
  .project { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 768px) { .project { grid-template-columns: 1fr minmax(0, 440px); gap: 56px; } }
  .project__tile { height: 160px; }
  @media (min-width: 768px) { .project__tile { height: 220px; } }
</style>
